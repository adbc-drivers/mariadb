// Result sets report JSON columns as LONGTEXT, so queries return plain
// strings. GetTableSchema recovers the JSON type from the JSON_VALID
// check constraint and returns the arrow.json extension type.

// part: expected_schema
{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "u",
            "flags": ["nullable"]
        }
    ]
}

// part: catalog_schema
{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "u",
            "flags": ["nullable"],
            "metadata": {
                "ARROW:extension:name": "arrow.json"
            }
        }
    ]
}

// part: expected
{"res": "{\"key\": \"value\", \"number\": 42}"}
{"res": "{\"array\": [1, 2, 3], \"nested\": {\"inner\": true}}"}
{"res": "[]"}
{"res": "{}"}
{"res": "null"}
{"res": "{\"unicode\": \"测试\", \"special\": \"chars@#$%\"}"}
{"res": "{\"large_number\": 9223372036854775807, \"boolean\": false}"}
{"res": null}
