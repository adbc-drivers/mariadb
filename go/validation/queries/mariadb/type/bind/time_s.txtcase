// MariaDB TIME is a signed duration (-838:59:59 to 838:59:59), so the
// driver returns it as an Arrow duration rather than a time of day.

// part: expected_schema

{
    "format": "+s",
    "children": [
        {
            "name": "res",
            "format": "tDs",
            "flags": ["nullable"]
        }
    ]
}

// part: expected

{"res": 0}
{"res": null}
{"res": 49531}
{"res": 45045}
{"res": 86399}
